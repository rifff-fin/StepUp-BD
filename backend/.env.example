# Copy to .env and fill in.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Leave empty in development to use an in-memory
# database (mongodb-memory-server, data resets on restart). Required in production.
MONGODB_URI=
MONGODB_DB_NAME=stepupbd

# Cloudinary: product photo uploads from the admin panel (the secret stays on the server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stepupbd/products

# Admin panel login (/admin). Use a long random JWT_SECRET, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Comma-separated list of allowed browser origins (only needed when the frontend calls the
# API directly; through the Netlify /api proxy or the Vite dev proxy it is same-origin).
CLIENT_ORIGIN=http://localhost:5173
